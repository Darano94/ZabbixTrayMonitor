<Window x:Class="ZabbixTrayMonitor.Views.SuppressUntilWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unterdrücken bis"
        Width="330"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Background="Transparent"
        KeyDown="Window_KeyDown">

    <Grid Margin="6">
        <Border CornerRadius="8"
                Background="{DynamicResource WindowBackgroundBrush}"
                Padding="12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="Transparent"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown"
                        Margin="0,0,0,12">
                    <TextBlock Text="Unterdrücken bis..."
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="14"
                               FontWeight="Bold" />
                </Border>

                <Grid Grid.Row="1"
                      Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Datum"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               VerticalAlignment="Center" />

                    <DatePicker x:Name="DatePicker"
                                Grid.Column="1"
                                Height="30"
                                SelectedDateFormat="Short"
                                VerticalContentAlignment="Center"
                                DateValidationError="DatePicker_DateValidationError" />
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Uhrzeit"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               VerticalAlignment="Center" />

                    <TextBox x:Name="TimeTextBox"
                             Grid.Column="1"
                             Height="30"
                             MaxLength="5"
                             VerticalContentAlignment="Center"
                             ToolTip="Format: HH:mm"
                             PreviewTextInput="TimeTextBox_PreviewTextInput" />
                </Grid>

                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,14,0,0">

                    <Button Content="Abbrechen"
                            Width="90"
                            Click="Cancel_Click" />

                    <Button Content="Unterdrücken"
                            Width="100"
                            Margin="8,0,0,0"
                            Click="Suppress_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
